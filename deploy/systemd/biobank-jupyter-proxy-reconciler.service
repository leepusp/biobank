[Unit]
Description=Biobank Jupyter proxy authorization reconciler
ConditionPathExists=/run/biobank-jupyter-proxy

[Service]
Type=oneshot
User=root
Group=root
UMask=0027
ExecStart=/usr/local/sbin/biobank-jupyter-proxy-reconciler

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=-/run/biobank-jupyter-proxy
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
