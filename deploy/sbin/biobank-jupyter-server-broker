#!/usr/bin/env bash
# Root-controlled Slurm runner for user-owned Biobank Jupyter servers.

set -euo pipefail
umask 0077

ENV_ROOT="/home/public/conda/envs/biobank"
PYTHON="$ENV_ROOT/bin/python"
RUNTIME_ROOT="/home/public/apps/biobank/runtime"
SERVER_SCRIPT="$RUNTIME_ROOT/notebook_server.sh"
STORAGE_HELPER="/usr/local/sbin/biobank-user-storage-broker"
PROXY_BINDING_ROOT="/run/biobank-jupyter-proxy"
PROXY_BINDING_GROUP="biobank-proxy"

fail() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

test "${EUID}" -eq 0 || fail "This helper must run as root."

validate_numeric_id() {
    [[ "$2" =~ ^[0-9]+$ ]] || fail "$1 must be numeric."
}

validate_run_id() {
    [[ "$1" =~ ^[A-Za-z0-9_-]{1,100}$ ]] ||
        fail "Invalid run identifier."
}

validate_partition() {
    case "$1" in
        basic|max50) ;;
        *) fail "Invalid partition. Allowed values: basic, max50." ;;
    esac
}

validate_node() {
    case "$1" in
        auto|n01|gn01|gn02|gn03) ;;
        *) fail "Invalid compute node. Allowed values: auto, n01, gn01, gn02, gn03." ;;
    esac
}

validate_integer_range() {
    local label="$1" value="$2" minimum="$3" maximum="$4"
    [[ "$value" =~ ^[0-9]+$ ]] || fail "$label must be numeric."
    (( value >= minimum && value <= maximum )) ||
        fail "$label must be between $minimum and $maximum."
}

load_user() {
    local username="$1"
    local passwd_record

    [[ "$username" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]] ||
        fail "Invalid Unix username."
    passwd_record="$(getent passwd "$username")" ||
        fail "Unix user was not found."
    IFS=: read -r ACCOUNT_NAME _ UID_NUMBER GID_NUMBER _ HOME_DIR LOGIN_SHELL \
        <<< "$passwd_record"
    test "$ACCOUNT_NAME" = "$username" || fail "Unix account mismatch."
    [[ "$UID_NUMBER" =~ ^[0-9]+$ ]] || fail "Invalid Unix UID."
    (( UID_NUMBER >= 1000 )) || fail "System accounts are not eligible."
    test "$HOME_DIR" = "/home/$username" ||
        fail "User home does not match /home/USERNAME."
    test -d "$HOME_DIR" || fail "User home does not exist."

    APP_USER="$username"
    LAB_ROOT="$HOME_DIR/biobank/lab_tools"
}

workspace_directory() {
    printf '%s/jupyter/notebooks/notebook_%s\n' "$LAB_ROOT" "$1"
}

notebook_job_root() {
    printf '%s/jupyter/jobs/notebook_%s\n' "$LAB_ROOT" "$1"
}

session_directory() {
    printf '%s/%s\n' "$(notebook_job_root "$1")" "$2"
}

ensure_runtime_access() {
    test -x "$PYTHON" || fail "Biobank Conda environment is unavailable."
    test -x "$SERVER_SCRIPT" || fail "Official Notebook server script is unavailable."
    test -x "$STORAGE_HELPER" || fail "User storage helper is unavailable."

}

prepare_directory() {
    "$STORAGE_HELPER" prepare-directory "$APP_USER" "$1" >/dev/null
}

write_user_file() {
    local path="$1" mode="$2"

    /usr/sbin/runuser -u "$APP_USER" -- /usr/bin/tee -- "$path" >/dev/null
    /usr/sbin/runuser -u "$APP_USER" -- /usr/bin/chmod "$mode" -- "$path"
}

read_user_file() {
    local path="$1"

    /usr/sbin/runuser -u "$APP_USER" -- /usr/bin/cat -- "$path"
}

remove_user_tree() {
    local path="$1"

    /usr/sbin/runuser -u "$APP_USER" -- \
        /usr/bin/rm -rf --one-file-system -- "$path"
}

remove_user_directory() {
    local path="$1"

    /usr/sbin/runuser -u "$APP_USER" -- \
        /usr/bin/rmdir -- "$path" \
        2>/dev/null || true
}

stored_job_id() {
    local run_dir="$1" job_id

    test -f "$run_dir/job_id" ||
        fail "Jupyter server session was not found."

    job_id="$(
        read_user_file "$run_dir/job_id" |
        /usr/bin/tr -cd '0-9'
    )"

    [[ "$job_id" =~ ^[0-9]+$ ]] ||
        fail "Invalid stored Slurm job ID."

    printf '%s\n' "$job_id"
}

validate_session_owner() {
    local run_dir="$1"
    local owner_marker

    test -f "$run_dir/slurm_user" ||
        fail "Session owner marker was not found."

    owner_marker="$(
        read_user_file "$run_dir/slurm_user"
    )"

    test "$owner_marker" = "$APP_USER" ||
        fail "Session does not belong to the requested user."
}

active_job_owner() {
    /usr/bin/squeue \
        --noheader \
        --jobs="$1" \
        --format='%u' |
        head -n 1 |
        xargs
}

slurm_state() {
    local job_id="$1" state
    state="$(
        /usr/bin/squeue \
            --noheader \
            --jobs="$job_id" \
            --user="$APP_USER" \
            --format='%T' |
        head -n 1 |
        xargs
    )"

    if test -z "$state"
    then
        state="$(
            /usr/bin/sacct \
                --noheader \
                --parsable2 \
                --jobs="$job_id" \
                --allocations \
                --format=State,User |
            awk -F'|' -v user="$APP_USER" '$2 == user {print $1; exit}' |
            xargs
        )"
    fi

    test -n "$state" || state="UNKNOWN"
    printf '%s\n' "$state"
}

is_terminal_state() {
    local state="${1%% *}"
    state="${state%%+*}"

    case "$state" in
        COMPLETED|FAILED|CANCELLED|TIMEOUT|OUT_OF_MEMORY|NODE_FAIL|PREEMPTED|BOOT_FAIL|DEADLINE|REVOKED)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

remove_run_directory() {
    local notebook_id="$1" run_id="$2"
    local job_root run_dir

    validate_numeric_id "Notebook ID" "$notebook_id"
    validate_run_id "$run_id"
    job_root="$(notebook_job_root "$notebook_id")"
    run_dir="$(session_directory "$notebook_id" "$run_id")"

    test "$run_dir" = "$job_root/$run_id" ||
        fail "Session cleanup path validation failed."
    test ! -L "$job_root" ||
        fail "Notebook job root may not be a symbolic link."
    test ! -L "$run_dir" ||
        fail "Session runtime may not be a symbolic link."

    if test -e "$run_dir"
    then
        test -d "$run_dir" ||
            fail "Session runtime is not a directory."
        remove_user_tree "$run_dir"
        test ! -e "$run_dir" ||
            fail "Session runtime could not be removed."
    fi

    remove_user_directory "$job_root"
}


proxy_binding_path() {
    local notebook_id="$1"

    validate_numeric_id \
        "Notebook ID" \
        "$notebook_id"

    printf '%s/notebook_%s.binding\n' \
        "$PROXY_BINDING_ROOT" \
        "$notebook_id"
}

ensure_proxy_binding_root() {
    if test -e "$PROXY_BINDING_ROOT"
    then
        test -d "$PROXY_BINDING_ROOT" ||
            fail "Jupyter proxy binding root is not a directory."

        test ! -L "$PROXY_BINDING_ROOT" ||
            fail "Jupyter proxy binding root may not be a symbolic link."
    else
        /usr/bin/install \
            -d \
            -m 0750 \
            -o root \
            -g "$PROXY_BINDING_GROUP" \
            "$PROXY_BINDING_ROOT"
    fi

    /usr/bin/chown \
        root:"$PROXY_BINDING_GROUP" \
        "$PROXY_BINDING_ROOT"

    /usr/bin/chmod \
        0750 \
        "$PROXY_BINDING_ROOT"
}

proxy_lease_path() {
    local notebook_id="$1"

    validate_numeric_id \
        "Notebook ID" \
        "$notebook_id"

    printf '%s/notebook_%s.lease\n' \
        "$PROXY_BINDING_ROOT" \
        "$notebook_id"
}

remove_proxy_binding() {
    local notebook_id="$1"
    local path lease owner_marker line
    local owner_seen=0

    path="$(proxy_binding_path "$notebook_id")"
    lease="$(proxy_lease_path "$notebook_id")"

    if test -e "$path" ||
       test -L "$path"
    then
        test ! -L "$path" ||
            fail "Jupyter proxy binding may not be a symbolic link."

        test -f "$path" ||
            fail "Jupyter proxy binding is not a regular file."

        owner_marker=""

        while IFS= read -r line ||
              test -n "$line"
        do
            case "$line" in
                owner=*)
                    test "$owner_seen" -eq 0 ||
                        fail "Jupyter proxy binding owner is duplicated."

                    owner_marker="${line#owner=}"
                    owner_seen=1
                    ;;
            esac
        done < "$path"

        test "$owner_seen" -eq 1 &&
        test -n "$owner_marker" ||
            fail "Jupyter proxy binding owner is missing."

        test "$owner_marker" = "$APP_USER" ||
            fail "Jupyter proxy binding belongs to another user."

        /usr/bin/rm \
            -f \
            -- \
            "$path"
    fi

    if test -e "$lease" ||
       test -L "$lease"
    then
        test ! -L "$lease" ||
            fail "Jupyter proxy lease may not be a symbolic link."

        test -f "$lease" ||
            fail "Jupyter proxy lease is not a regular file."

        /usr/bin/rm \
            -f \
            -- \
            "$lease"
    fi
}

write_proxy_lease() {
    test "$#" -eq 5 ||
        fail "write_proxy_lease requires NOTEBOOK_ID RUN_ID JOB_ID HOST PORT."

    local notebook_id="$1"
    local run_id="$2"
    local job_id="$3"
    local host="$4"
    local port="$5"

    local path temporary validated_at

    validate_numeric_id \
        "Notebook ID" \
        "$notebook_id"

    validate_run_id "$run_id"

    [[ "$job_id" =~ ^[0-9]+$ ]] ||
        fail "Invalid Slurm job ID for proxy lease."

    case "$host" in
        n01|gn01|gn02|gn03)
            ;;
        *)
            fail "Invalid Jupyter proxy lease host."
            ;;
    esac

    [[ "$port" =~ ^[0-9]+$ ]] ||
        fail "Invalid Jupyter proxy lease port."

    (( port >= 1024 && port <= 65535 )) ||
        fail "Jupyter proxy lease port is outside the allowed range."

    ensure_proxy_binding_root

    path="$(proxy_lease_path "$notebook_id")"

    if test -e "$path" ||
       test -L "$path"
    then
        test ! -L "$path" ||
            fail "Jupyter proxy lease may not be a symbolic link."

        test -f "$path" ||
            fail "Jupyter proxy lease is not a regular file."
    fi

    validated_at="$(/usr/bin/date +%s)"

    [[ "$validated_at" =~ ^[0-9]+$ ]] ||
        fail "Unable to determine Jupyter proxy lease timestamp."

    temporary="$(
        /usr/bin/mktemp \
            "${PROXY_BINDING_ROOT}/.notebook_${notebook_id}.lease.XXXXXX"
    )"

    if ! {
        printf '%s\n' \
            "version=1" \
            "notebook_id=${notebook_id}" \
            "owner=${APP_USER}" \
            "run_id=${run_id}" \
            "job_id=${job_id}" \
            "host=${host}" \
            "port=${port}" \
            "validated_at=${validated_at}" \
            > "$temporary"

        /usr/bin/chown \
            root:"$PROXY_BINDING_GROUP" \
            "$temporary"

        /usr/bin/chmod \
            0640 \
            "$temporary"

        /usr/bin/mv \
            -fT \
            -- \
            "$temporary" \
            "$path"
    }
    then
        /usr/bin/rm \
            -f \
            -- \
            "$temporary"

        fail "Jupyter proxy lease could not be installed."
    fi

    test -f "$path" &&
    test ! -L "$path" ||
        fail "Jupyter proxy lease installation failed."
}

active_job_node() {
    /usr/bin/squeue \
        --noheader \
        --jobs="$1" \
        --user="$APP_USER" \
        --format='%N' |
        /usr/bin/head -n 1 |
        /usr/bin/xargs
}

active_job_state() {
    /usr/bin/squeue \
        --noheader \
        --jobs="$1" \
        --user="$APP_USER" \
        --format='%T' |
        /usr/bin/head -n 1 |
        /usr/bin/xargs
}

sync_proxy_binding() {
    test "$#" -eq 4 ||
        fail "sync_proxy_binding requires NOTEBOOK_ID RUN_ID JOB_ID SERVER_JSON."

    local notebook_id="$1"
    local run_id="$2"
    local job_id="$3"
    local server_json="$4"

    local host port expected_base
    local owner node state
    local path temporary
    local -a endpoint=()

    validate_numeric_id \
        "Notebook ID" \
        "$notebook_id"

    validate_run_id "$run_id"

    [[ "$job_id" =~ ^[0-9]+$ ]] ||
        fail "Invalid Slurm job ID for proxy binding."

    mapfile -t endpoint < <(
        "$PYTHON" \
            - \
            "$server_json" \
            "$notebook_id" <<'PYTHON'
import json
import sys

payload = json.loads(sys.argv[1])
notebook_id = sys.argv[2]

host = str(payload.get("host") or "")
status = str(payload.get("status") or "")
base_url = str(payload.get("base_url") or "")

try:
    port = int(payload.get("port"))
except (TypeError, ValueError):
    raise SystemExit(
        "Invalid Jupyter proxy port."
    )

allowed_hosts = {
    "n01",
    "gn01",
    "gn02",
    "gn03",
}

if host not in allowed_hosts:
    raise SystemExit(
        "Invalid Jupyter proxy host."
    )

if not 1024 <= port <= 65535:
    raise SystemExit(
        "Invalid Jupyter proxy port."
    )

expected_base = (
    "/b3lims/internal/lab-tools/"
    f"jupyter/{notebook_id}/"
    f"node/{host}/{port}/"
)

if status != "ready":
    raise SystemExit(
        "Jupyter server is not ready."
    )

if base_url != expected_base:
    raise SystemExit(
        "Jupyter base URL does not match "
        "the proxy binding."
    )

print(host)
print(port)
PYTHON
    )

    test "${#endpoint[@]}" -eq 2 ||
        fail "Invalid Jupyter endpoint metadata."

    host="${endpoint[0]}"
    port="${endpoint[1]}"

    expected_base="/b3lims/internal/lab-tools/jupyter/${notebook_id}/node/${host}/${port}/"

    owner="$(active_job_owner "$job_id")"

    test "$owner" = "$APP_USER" ||
        fail "Slurm job owner does not match proxy binding."

    state="$(active_job_state "$job_id")"

    test "$state" = "RUNNING" ||
        fail "Only a running Slurm job may receive a proxy binding."

    node="$(active_job_node "$job_id")"

    test "$node" = "$host" ||
        fail "Allocated Slurm node does not match Jupyter host."

    ensure_proxy_binding_root

    path="$(proxy_binding_path "$notebook_id")"

    if test -e "$path" ||
       test -L "$path"
    then
        remove_proxy_binding "$notebook_id"
    fi

    temporary="$(
        /usr/bin/mktemp \
            "${PROXY_BINDING_ROOT}/.notebook_${notebook_id}.XXXXXX"
    )"

    if ! {
        printf '%s\n' \
            "version=1" \
            "notebook_id=${notebook_id}" \
            "owner=${APP_USER}" \
            "run_id=${run_id}" \
            "job_id=${job_id}" \
            "host=${host}" \
            "port=${port}" \
            > "$temporary"

        /usr/bin/chown \
            root:"$PROXY_BINDING_GROUP" \
            "$temporary"

        /usr/bin/chmod \
            0640 \
            "$temporary"

        /usr/bin/mv \
            -fT \
            -- \
            "$temporary" \
            "$path"
    }
    then
        /usr/bin/rm \
            -f \
            -- \
            "$temporary"

        fail "Jupyter proxy binding could not be installed."
    fi

    test -f "$path" &&
    test ! -L "$path" ||
        fail "Jupyter proxy binding installation failed."

    write_proxy_lease \
        "$notebook_id" \
        "$run_id" \
        "$job_id" \
        "$host" \
        "$port"
}

server_start() {
    test "$#" -eq 8 ||
        fail "server-start requires NOTEBOOK_ID USER_ID USER CPUS MEMORY MINUTES PARTITION NODE."

    local notebook_id="$1" user_id="$2" username="$3"
    local cpus="$4" memory_mb="$5" minutes="$6" partition="$7" node="$8"
    local workspace notebook_file run_id run_dir job_script job_id
    local maximum_minutes
    local -a node_arguments=()

    validate_numeric_id "Notebook ID" "$notebook_id"
    validate_numeric_id "Application user ID" "$user_id"
    validate_integer_range "CPU count" "$cpus" 1 128
    validate_integer_range "Memory" "$memory_mb" 1024 1048576
    validate_integer_range "Time" "$minutes" 60 10080
    validate_partition "$partition"
    validate_node "$node"
    case "$partition" in
        basic) maximum_minutes=4320 ;;
        max50) maximum_minutes=10080 ;;
    esac
    (( minutes <= maximum_minutes )) ||
        fail "Time exceeds the selected partition limit."
    if test "$node" != "auto"
    then
        node_arguments=("--nodelist=$node")
    fi
    load_user "$username"
    remove_proxy_binding "$notebook_id"
    ensure_runtime_access
    "$STORAGE_HELPER" ensure "$APP_USER" >/dev/null

    workspace="$(workspace_directory "$notebook_id")"
    prepare_directory "jupyter/notebooks/notebook_${notebook_id}"
    notebook_file="$workspace/notebook.ipynb"

    if test ! -e "$notebook_file"
    then
        /usr/sbin/runuser -u "$APP_USER" -- \
            env HOME="$HOME_DIR" USER="$APP_USER" LOGNAME="$APP_USER" \
            "$PYTHON" - "$notebook_file" "$APP_USER" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
username = sys.argv[2]
payload = {
    "cells": [],
    "metadata": {
        "biobank": {"owner": username},
        "kernelspec": {
            "display_name": "Python 3 (ipykernel)",
            "language": "python",
            "name": "python3",
        },
        "language_info": {"name": "python"},
    },
    "nbformat": 4,
    "nbformat_minor": 5,
}
temporary = path.with_suffix(".tmp")
temporary.write_text(json.dumps(payload, indent=2) + "\n")
temporary.chmod(0o660)
temporary.replace(path)
PY
    fi

    test ! -L "$notebook_file" && test -f "$notebook_file" ||
        fail "Notebook path is not a regular file."
    "$STORAGE_HELPER" claim-file \
        "$APP_USER" \
        "jupyter/notebooks/notebook_${notebook_id}/notebook.ipynb" \
        >/dev/null

    run_id="$(date -u +%Y%m%dT%H%M%SZ)_$$_${RANDOM}"
    validate_run_id "$run_id"
    run_dir="$(session_directory "$notebook_id" "$run_id")"
    prepare_directory "jupyter/jobs/notebook_${notebook_id}/${run_id}"

    job_script="$run_dir/session.sh"
    {
        printf '#!/usr/bin/env bash\n'
        printf 'set -euo pipefail\n'
        printf 'umask 0077\n'
        printf 'export HOME=%q USER=%q LOGNAME=%q\n' \
            "$HOME_DIR" "$APP_USER" "$APP_USER"
        printf 'export XDG_CACHE_HOME=%q XDG_CONFIG_HOME=%q XDG_DATA_HOME=%q\n' \
            "$HOME_DIR/.cache" "$HOME_DIR/.config" "$HOME_DIR/.local/share"
        printf 'export BIOBANK_APP_USER=%q BIOBANK_NOTEBOOK_ID=%q\n' \
            "$APP_USER" "$notebook_id"
        printf 'exec %q %q %q %q\n' \
            "$SERVER_SCRIPT" "$workspace" "$run_dir" "notebook.ipynb"
    } | write_user_file "$job_script" 0700

    if ! job_id="$(
        /usr/sbin/runuser -u "$APP_USER" -- \
            env HOME="$HOME_DIR" USER="$APP_USER" LOGNAME="$APP_USER" \
            /usr/bin/sbatch \
                --parsable \
                --partition="$partition" \
                "${node_arguments[@]}" \
                --job-name="biobank_notebook_${notebook_id}" \
                --comment="BIOBANK_JUPYTER=${notebook_id},USER=${APP_USER},RUN=${run_id}" \
                --nodes=1 \
                --ntasks=1 \
                --cpus-per-task="$cpus" \
                --mem="${memory_mb}M" \
                --time="$minutes" \
                --chdir="$run_dir" \
                --output="$run_dir/slurm-%j.out" \
                --error="$run_dir/slurm-%j.err" \
                "$job_script"
    )"
    then
        remove_run_directory "$notebook_id" "$run_id"
        fail "Slurm submission failed."
    fi
    job_id="${job_id%%;*}"
    [[ "$job_id" =~ ^[0-9]+$ ]] || fail "Slurm returned an invalid job ID."

    printf '%s\n' "$job_id" |
        write_user_file "$run_dir/job_id" 0600

    printf '%s\n' "$APP_USER" |
        write_user_file "$run_dir/slurm_user" 0600

    printf '{"status":"submitted","job_id":"%s","notebook_id":%s,"run_id":"%s","run_dir":"%s","workspace":"%s","notebook_file":"%s","partition":"%s","requested_node":"%s","slurm_user":"%s"}\n' \
        "$job_id" "$notebook_id" "$run_id" "$run_dir" "$workspace" \
        "$notebook_file" "$partition" "$node" "$APP_USER"
}

server_status() {
    test "$#" -eq 3 || fail "server-status requires NOTEBOOK_ID USER RUN_ID."
    local notebook_id="$1" username="$2" run_id="$3"
    local run_dir job_id state ready=false server_json='{}'
    local run_directory_removed=false

    validate_numeric_id "Notebook ID" "$notebook_id"
    validate_run_id "$run_id"
    load_user "$username"
    run_dir="$(session_directory "$notebook_id" "$run_id")"
    validate_session_owner "$run_dir"
    job_id="$(stored_job_id "$run_dir")"
    state="$(slurm_state "$job_id")"

    if test -f "$run_dir/connection.json"
    then
        server_json="$(
            /usr/sbin/runuser -u "$APP_USER" -- \
                "$PYTHON" - "$run_dir/connection.json" <<'PY'
import json
import sys
from pathlib import Path

try:
    data = json.loads(Path(sys.argv[1]).read_text())
except (OSError, ValueError, TypeError):
    print("{}")
else:
    safe = {
        key: data.get(key)
        for key in (
            "status", "host", "port", "base_url",
            "default_url", "notebook", "ready_at",
        )
    }
    print(json.dumps(safe, separators=(",", ":")))
PY
        )"
        if test "$("$PYTHON" -c 'import json,sys; print(str(json.loads(sys.argv[1]).get("status") == "ready").lower())' "$server_json")" = true
        then
            ready=true
        fi
    fi

    if test "$state" = "RUNNING" &&
       test "$ready" = true
    then
        sync_proxy_binding \
            "$notebook_id" \
            "$run_id" \
            "$job_id" \
            "$server_json"
    else
        remove_proxy_binding "$notebook_id"
    fi

    if is_terminal_state "$state"
    then
        remove_run_directory "$notebook_id" "$run_id"
        run_directory_removed=true
    fi

    printf '{"status":"ok","job_id":"%s","notebook_id":%s,"run_id":"%s","state":"%s","ready":%s,"run_dir":"%s","slurm_user":"%s","run_directory_removed":%s,"server":%s}\n' \
        "$job_id" "$notebook_id" "$run_id" "$state" "$ready" \
        "$run_dir" "$APP_USER" "$run_directory_removed" "$server_json"
}

server_stop() {
    test "$#" -eq 3 || fail "server-stop requires NOTEBOOK_ID USER RUN_ID."
    local notebook_id="$1" username="$2" run_id="$3"
    local run_dir job_id owner
    local run_directory_removed=false

    validate_numeric_id "Notebook ID" "$notebook_id"
    validate_run_id "$run_id"
    load_user "$username"
    run_dir="$(session_directory "$notebook_id" "$run_id")"
    validate_session_owner "$run_dir"
    job_id="$(stored_job_id "$run_dir")"
    remove_proxy_binding "$notebook_id"
    owner="$(active_job_owner "$job_id")"

    if test -z "$owner"
    then
        remove_run_directory "$notebook_id" "$run_id"
        run_directory_removed=true
        printf '{"status":"already_stopped","job_id":"%s","notebook_id":%s,"run_id":"%s","slurm_user":"%s","run_directory_removed":%s}\n' \
            "$job_id" "$notebook_id" "$run_id" "$APP_USER" "$run_directory_removed"
        return 0
    fi

    test "$owner" = "$APP_USER" || fail "Slurm job belongs to another user."
    /usr/sbin/runuser -u "$APP_USER" -- \
        /usr/bin/scancel "$job_id"

    for _ in $(seq 1 50)
    do
        owner="$(active_job_owner "$job_id")"
        test -n "$owner" || break
        sleep 0.2
    done

    if test -z "$owner"
    then
        remove_run_directory "$notebook_id" "$run_id"
        run_directory_removed=true
    fi

    printf '{"status":"stopped","job_id":"%s","notebook_id":%s,"run_id":"%s","slurm_user":"%s","run_directory_removed":%s}\n' \
        "$job_id" "$notebook_id" "$run_id" "$APP_USER" "$run_directory_removed"
}

session_cleanup() {
    test "$#" -eq 3 ||
        fail "session-cleanup requires NOTEBOOK_ID USER RUN_ID."
    local notebook_id="$1" username="$2" run_id="$3"
    local run_dir job_id owner removed=false

    validate_numeric_id "Notebook ID" "$notebook_id"
    validate_run_id "$run_id"
    load_user "$username"
    run_dir="$(session_directory "$notebook_id" "$run_id")"

    if test -e "$run_dir/slurm_user"
    then
        validate_session_owner "$run_dir"
    fi

    remove_proxy_binding "$notebook_id"

    if test -e "$run_dir/job_id"
    then
        test -e "$run_dir/slurm_user" ||
            fail "Session owner marker was not found."
        job_id="$(stored_job_id "$run_dir")"
        owner="$(active_job_owner "$job_id")"
        test -z "$owner" ||
            fail "Active session runtime may not be removed."
    fi

    if test -e "$run_dir"
    then
        remove_run_directory "$notebook_id" "$run_id"
        removed=true
    fi

    printf '{"status":"ok","notebook_id":%s,"run_id":"%s","slurm_user":"%s","run_directory_removed":%s}\n' \
        "$notebook_id" "$run_id" "$APP_USER" "$removed"
}

workspace_delete() {
    test "$#" -eq 3 ||
        fail "workspace-delete requires NOTEBOOK_ID USER_ID USER."
    local notebook_id="$1" user_id="$2" username="$3"
    local workspace removed=false

    validate_numeric_id "Notebook ID" "$notebook_id"
    validate_numeric_id "Application user ID" "$user_id"
    load_user "$username"
    workspace="$(workspace_directory "$notebook_id")"
    test ! -L "$workspace" || fail "Notebook workspace may not be a symbolic link."

    if test -e "$workspace"
    then
        test -d "$workspace" || fail "Notebook workspace is not a directory."
        remove_user_tree "$workspace"
        test ! -e "$workspace" || fail "Notebook workspace could not be removed."
        removed=true
    fi

    printf '{"status":"ok","notebook_id":%s,"user_id":%s,"app_user":"%s","workspace_removed":%s}\n' \
        "$notebook_id" "$user_id" "$APP_USER" "$removed"
}

ACTION="${1:-}"
shift || true

case "$ACTION" in
    server-start) server_start "$@" ;;
    server-status) server_status "$@" ;;
    server-stop) server_stop "$@" ;;
    session-cleanup) session_cleanup "$@" ;;
    workspace-delete) workspace_delete "$@" ;;
    *) fail "Usage: $0 {server-start|server-status|server-stop|session-cleanup|workspace-delete} ..." ;;
esac
