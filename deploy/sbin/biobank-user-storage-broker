#!/usr/bin/python3
"""Root-controlled, fd-anchored Biobank per-user storage broker."""

import errno
import json
import os
import pwd
import re
import stat
import subprocess
import sys


APP_USER = "biobank"
HOME_ROOT = "/home"
SETFACL = "/usr/bin/setfacl"

DIRECTORY_FLAGS = (
    os.O_RDONLY
    | os.O_DIRECTORY
    | os.O_NOFOLLOW
    | os.O_CLOEXEC
)

FILE_FLAGS = (
    os.O_RDONLY
    | os.O_NOFOLLOW
    | os.O_CLOEXEC
    | os.O_NONBLOCK
)

USERNAME_RE = re.compile(
    r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
)

LAB_DIRECTORY_RE = re.compile(
    r"^(?:"
    r"eln/entries/[0-9]+/attachments"
    r"|jupyter/notebooks/notebook_[0-9]+"
    r"|jupyter/jobs/notebook_[0-9]+"
    r"|jupyter/jobs/notebook_[0-9]+/[A-Za-z0-9_-]+"
    r"|molecular/records/[0-9]+"
    r"|molecular/records/[0-9]+/alignments"
    r"|molecular/records/[0-9]+/structures"
    r"|exports(?:/[A-Za-z0-9_.-]+)?"
    r"|tmp(?:/[A-Za-z0-9_.-]+)?"
    r")$"
)

LAB_FILE_RE = re.compile(
    r"^(?:"
    r"eln/entries/[0-9]+/attachments/[A-Za-z0-9_.-]+"
    r"|jupyter/notebooks/notebook_[0-9]+/notebook\.ipynb"
    r"|molecular/records/[0-9]+/[A-Za-z0-9_.-]+"
    r"|molecular/records/[0-9]+/alignments/[A-Za-z0-9_.-]+"
    r"|molecular/records/[0-9]+/structures/[A-Za-z0-9_.-]+"
    r"|exports/[A-Za-z0-9_.-]+"
    r"|tmp/[A-Za-z0-9_.-]+"
    r")$"
)

DATA_DIRECTORY_RE = re.compile(
    r"^samples/sample_[0-9]+_[A-Za-z0-9._-]+/files$"
)

DATA_FILE_RE = re.compile(
    r"^samples/sample_[0-9]+_[A-Za-z0-9._-]+/"
    r"files/[A-Za-z0-9][A-Za-z0-9_.-]{0,254}$"
)

BASE_LAYOUT = (
    "biobank",
    "biobank/data",
    "biobank/data/samples",
    "biobank/lab_tools",
    "biobank/lab_tools/eln",
    "biobank/lab_tools/eln/entries",
    "biobank/lab_tools/jupyter",
    "biobank/lab_tools/jupyter/notebooks",
    "biobank/lab_tools/jupyter/jobs",
    "biobank/lab_tools/molecular",
    "biobank/lab_tools/molecular/records",
    "biobank/lab_tools/exports",
    "biobank/lab_tools/tmp",
)


class BrokerError(RuntimeError):
    pass


class UserContext:
    __slots__ = (
        "username",
        "uid",
        "gid",
        "home",
    )

    def __init__(self, username, uid, gid, home):
        self.username = username
        self.uid = uid
        self.gid = gid
        self.home = home


def fail(message):
    raise BrokerError(message)


def validate_username(username):
    if not USERNAME_RE.fullmatch(username):
        fail("Invalid Unix username.")


def validate_relative(value, pattern, label):
    if (
        not value
        or ".." in value
        or "//" in value
        or not pattern.fullmatch(value)
    ):
        fail(label)


def load_user(username):
    validate_username(username)

    try:
        record = pwd.getpwnam(username)
    except KeyError:
        fail("Unix user was not found.")

    if record.pw_uid < 1000:
        fail("System accounts are not eligible.")

    expected_home = f"/home/{username}"

    if record.pw_dir != expected_home:
        fail("User home does not match /home/USERNAME.")

    return UserContext(
        username=username,
        uid=record.pw_uid,
        gid=record.pw_gid,
        home=expected_home,
    )


def _validate_component(component):
    if (
        not component
        or component in {".", ".."}
        or "/" in component
        or "\x00" in component
    ):
        fail("Invalid managed path component.")


def _open_existing_directory(
    parent_fd,
    component,
    expected_device=None,
):
    _validate_component(component)

    try:
        fd = os.open(
            component,
            DIRECTORY_FLAGS,
            dir_fd=parent_fd,
        )
    except FileNotFoundError:
        raise
    except OSError as exc:
        if exc.errno in {
            errno.ELOOP,
            errno.ENOTDIR,
        }:
            fail(
                "Managed directory component is not a real directory."
            )
        raise

    try:
        metadata = os.fstat(fd)

        if not stat.S_ISDIR(metadata.st_mode):
            fail("Managed path component is not a directory.")

        if (
            expected_device is not None
            and metadata.st_dev != expected_device
        ):
            fail(
                "Managed storage may not cross filesystem boundaries."
            )

        return fd
    except Exception:
        os.close(fd)
        raise


def _open_absolute_directory_no_symlinks(path):
    if not path.startswith("/"):
        fail("Absolute directory path is required.")

    components = [
        value
        for value in path.split("/")
        if value
    ]

    current_fd = os.open(
        "/",
        DIRECTORY_FLAGS,
    )

    try:
        for component in components:
            next_fd = _open_existing_directory(
                current_fd,
                component,
            )

            os.close(current_fd)
            current_fd = next_fd

        return current_fd
    except Exception:
        os.close(current_fd)
        raise


def _open_home(context):
    home_root_fd = _open_absolute_directory_no_symlinks(
        HOME_ROOT
    )

    try:
        home_fd = _open_existing_directory(
            home_root_fd,
            context.username,
        )
    finally:
        os.close(home_root_fd)

    try:
        metadata = os.fstat(home_fd)

        if metadata.st_uid != context.uid:
            fail(
                "User home ownership does not match the Unix account."
            )

        return home_fd
    except Exception:
        os.close(home_fd)
        raise


def _run_setfacl(fd, *arguments):
    try:
        completed = subprocess.run(
            [
                SETFACL,
                *arguments,
                f"/proc/self/fd/{fd}",
            ],
            check=False,
            pass_fds=(fd,),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )
    except OSError as exc:
        fail(
            f"Unable to execute setfacl: {exc.strerror}."
        )

    if completed.returncode != 0:
        message = completed.stderr.strip()

        if not message:
            message = "setfacl failed"

        fail(message)


def _grant_home_traverse(home_fd, context):
    if context.username == APP_USER:
        return

    _run_setfacl(
        home_fd,
        "-m",
        f"u:{APP_USER}:--x",
    )


def _directory_acl(context):
    if context.username == APP_USER:
        return (
            "u::rwx,g::---,m::---,o::---"
        )

    return (
        f"u::rwx,u:{APP_USER}:rwx,"
        "g::---,m::rwx,o::---"
    )


def _file_acl(context):
    if context.username == APP_USER:
        return (
            "u::rw-,g::---,m::---,o::---"
        )

    return (
        f"u::rw-,u:{APP_USER}:rw-,"
        "g::---,m::rw-,o::---"
    )


def _normalize_directory(fd, context):
    os.fchown(
        fd,
        context.uid,
        context.gid,
    )

    os.fchmod(
        fd,
        0o700,
    )

    acl = _directory_acl(context)

    _run_setfacl(
        fd,
        "--set",
        acl,
    )

    _run_setfacl(
        fd,
        "-d",
        "--set",
        acl,
    )


def _normalize_file(fd, context):
    os.fchown(
        fd,
        context.uid,
        context.gid,
    )

    os.fchmod(
        fd,
        0o600,
    )

    _run_setfacl(
        fd,
        "--set",
        _file_acl(context),
    )


def _open_or_create_directory(
    parent_fd,
    component,
    context,
    expected_device,
):
    _validate_component(component)

    for _attempt in range(4):
        try:
            fd = _open_existing_directory(
                parent_fd,
                component,
                expected_device,
            )
        except FileNotFoundError:
            try:
                os.mkdir(
                    component,
                    mode=0o700,
                    dir_fd=parent_fd,
                )
            except FileExistsError:
                continue

            fd = _open_existing_directory(
                parent_fd,
                component,
                expected_device,
            )

        _normalize_directory(
            fd,
            context,
        )

        return fd

    fail(
        "Managed directory changed repeatedly during creation."
    )


def _split_relative(relative):
    values = relative.split("/")

    for value in values:
        _validate_component(value)

    return values


def _ensure_chain(
    home_fd,
    relative,
    context,
    expected_device,
):
    current_fd = os.dup(home_fd)

    try:
        for component in _split_relative(relative):
            next_fd = _open_or_create_directory(
                current_fd,
                component,
                context,
                expected_device,
            )

            os.close(current_fd)
            current_fd = next_fd

        return current_fd
    except Exception:
        os.close(current_fd)
        raise


def _open_chain(
    home_fd,
    relative,
    context,
    expected_device,
):
    current_fd = os.dup(home_fd)

    try:
        for component in _split_relative(relative):
            next_fd = _open_existing_directory(
                current_fd,
                component,
                expected_device,
            )

            _normalize_directory(
                next_fd,
                context,
            )

            os.close(current_fd)
            current_fd = next_fd

        return current_fd
    except Exception:
        os.close(current_fd)
        raise


def _open_regular_file(
    parent_fd,
    filename,
    expected_device,
):
    _validate_component(filename)

    try:
        fd = os.open(
            filename,
            FILE_FLAGS,
            dir_fd=parent_fd,
        )
    except OSError as exc:
        if exc.errno in {
            errno.ELOOP,
            errno.ENOTDIR,
        }:
            fail(
                "Managed file may not be a symbolic link."
            )
        raise

    try:
        metadata = os.fstat(fd)

        if not stat.S_ISREG(metadata.st_mode):
            fail("Managed path is not a regular file.")

        if metadata.st_dev != expected_device:
            fail(
                "Managed file may not cross filesystem boundaries."
            )

        return fd
    except Exception:
        os.close(fd)
        raise


def ensure_layout(
    home_fd,
    context,
    expected_device,
):
    _grant_home_traverse(
        home_fd,
        context,
    )

    for relative in BASE_LAYOUT:
        fd = _ensure_chain(
            home_fd,
            relative,
            context,
            expected_device,
        )

        os.close(fd)


def prepare_lab_directory(
    home_fd,
    context,
    relative,
    expected_device,
):
    validate_relative(
        relative,
        LAB_DIRECTORY_RE,
        "Storage directory is outside the managed layout.",
    )

    fd = _ensure_chain(
        home_fd,
        f"biobank/lab_tools/{relative}",
        context,
        expected_device,
    )

    os.close(fd)


def prepare_data_directory(
    home_fd,
    context,
    relative,
    expected_device,
):
    validate_relative(
        relative,
        DATA_DIRECTORY_RE,
        "Sample data directory is outside the managed layout.",
    )

    fd = _ensure_chain(
        home_fd,
        f"biobank/data/{relative}",
        context,
        expected_device,
    )

    os.close(fd)


def claim_file(
    home_fd,
    context,
    relative,
    prefix,
    pattern,
    error_message,
    expected_device,
):
    validate_relative(
        relative,
        pattern,
        error_message,
    )

    components = _split_relative(relative)

    filename = components[-1]
    parent_relative = "/".join(
        components[:-1]
    )

    managed_parent = prefix

    if parent_relative:
        managed_parent = (
            f"{prefix}/{parent_relative}"
        )

    parent_fd = _open_chain(
        home_fd,
        managed_parent,
        context,
        expected_device,
    )

    try:
        file_fd = _open_regular_file(
            parent_fd,
            filename,
            expected_device,
        )
    finally:
        os.close(parent_fd)

    try:
        _normalize_file(
            file_fd,
            context,
        )
    finally:
        os.close(file_fd)


def execute(action, username, relative=None):
    context = load_user(username)

    home_fd = _open_home(context)

    try:
        home_metadata = os.fstat(home_fd)
        expected_device = home_metadata.st_dev

        ensure_layout(
            home_fd,
            context,
            expected_device,
        )

        if action == "ensure":
            if relative is not None:
                fail("ensure does not accept a path.")

        elif action == "prepare-directory":
            if relative is None:
                fail(
                    "prepare-directory requires USERNAME PATH."
                )

            prepare_lab_directory(
                home_fd,
                context,
                relative,
                expected_device,
            )

        elif action == "claim-file":
            if relative is None:
                fail(
                    "claim-file requires USERNAME PATH."
                )

            claim_file(
                home_fd,
                context,
                relative,
                "biobank/lab_tools",
                LAB_FILE_RE,
                "Storage file is outside the managed layout.",
                expected_device,
            )

        elif action == "prepare-data-directory":
            if relative is None:
                fail(
                    "prepare-data-directory requires USERNAME PATH."
                )

            prepare_data_directory(
                home_fd,
                context,
                relative,
                expected_device,
            )

        elif action == "claim-data-file":
            if relative is None:
                fail(
                    "claim-data-file requires USERNAME PATH."
                )

            claim_file(
                home_fd,
                context,
                relative,
                "biobank/data",
                DATA_FILE_RE,
                "Sample data file is outside the managed layout.",
                expected_device,
            )

        else:
            fail(
                "Usage: biobank-user-storage-broker "
                "{ensure|prepare-directory|claim-file|"
                "prepare-data-directory|claim-data-file} "
                "USERNAME [PATH]"
            )

    finally:
        os.close(home_fd)

    return {
        "status": "ok",
        "user": context.username,
        "root": (
            f"{context.home}/biobank/lab_tools"
        ),
    }


def main(argv):
    if os.geteuid() != 0:
        fail("This helper must run as root.")

    if len(argv) not in {3, 4}:
        fail(
            "Usage: biobank-user-storage-broker "
            "{ensure|prepare-directory|claim-file|"
            "prepare-data-directory|claim-data-file} "
            "USERNAME [PATH]"
        )

    action = argv[1]
    username = argv[2]
    relative = (
        argv[3]
        if len(argv) == 4
        else None
    )

    result = execute(
        action,
        username,
        relative,
    )

    print(
        json.dumps(
            result,
            separators=(",", ":"),
            sort_keys=True,
        )
    )


if __name__ == "__main__":
    try:
        main(sys.argv)
    except BrokerError as exc:
        print(
            f"ERROR: {exc}",
            file=sys.stderr,
        )
        raise SystemExit(1)
    except (OSError, subprocess.SubprocessError) as exc:
        message = getattr(
            exc,
            "strerror",
            None,
        ) or str(exc)

        print(
            f"ERROR: storage operation failed: {message}",
            file=sys.stderr,
        )
        raise SystemExit(1)
